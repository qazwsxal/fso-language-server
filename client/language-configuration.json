{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"]
  ],
  "wordPattern": "\"[^\"\\r\\n]*\"|[^\\s\"(),:;]+(?:[ \\t]+[^\\s\"(),:;]+)*",
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["(", ")"]
  ]
}
