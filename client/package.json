{
  "name": "fs-tables",
  "displayName": "FS Tables",
  "description": "Language support for FreeSpace Open (FSO) mod table files (.tbl / .tbm)",
  "version": "0.0.1",
  "publisher": "qazwsxal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "freespace",
    "freespace open",
    "fso",
    "tbl",
    "tbm"
  ],
  "activationEvents": [
    "onLanguage:fso-table"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fso-table",
        "aliases": [
          "FSO Table",
          "fso-table"
        ],
        "extensions": [
          ".tbl",
          ".tbm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fso-mission",
        "aliases": [
          "FSO Mission",
          "fso-mission"
        ],
        "extensions": [
          ".fs2",
          ".fc2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fso-table",
        "scopeName": "source.fso-table",
        "path": "./syntaxes/fso-table.tmLanguage.json"
      },
      {
        "language": "fso-mission",
        "scopeName": "source.fso-table",
        "path": "./syntaxes/fso-table.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fsoLsp.revealDefinitionOrPofViewer",
        "title": "Go to Definition (FSO Table)"
      },
      {
        "command": "fsoLsp.openPofViewerAtPosition",
        "title": "Open 3D POF Viewer at Position (FSO Table)"
      }
    ],
    "keybindings": [
      {
        "command": "fsoLsp.revealDefinitionOrPofViewer",
        "key": "F12",
        "when": "editorTextFocus && editorLangId == fso-table"
      }
    ],
    "configuration": {
      "title": "FS Tables",
      "properties": {
        "fsoLsp.unknownFieldSeverity": {
          "type": "string",
          "enum": ["off", "warning", "error"],
          "default": "off",
          "description": "How to report a $Field:/+Field: this extension doesn't recognize for the table it appears in. A field known to belong to a DIFFERENT table (e.g. a weapons.tbl field pasted into ships.tbl) is always reported as a warning regardless of this setting - this only controls fields unrecognized by every schema this extension knows about, which may simply be real, newer FSO fields it hasn't been taught about yet."
        },
        "fsoLsp.trimSharedSourcePrefix": {
          "type": "boolean",
          "default": true,
          "description": "In the effective-definition hover's 'Layers applied' list and field table, strip the longest path prefix shared by every source shown (e.g. a common 'E:\\Games\\Knossos\\FS2\\' folder) so it isn't repeated on every line."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit",
    "pretest": "node ../build.js && tsc -p ./tsconfig.test.json",
    "test": "node ./out/test/runTest.js",
    "package": "node ../build.js && node ./scripts/package.js"
  },
  "dependencies": {
    "three": "^0.169.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^18.19.0",
    "@types/three": "^0.169.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.18.0",
    "mocha": "^10.7.3",
    "typescript": "^5.5.4"
  }
}
