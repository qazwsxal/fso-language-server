{
  "name": "fso-lsp",
  "displayName": "FSO Table Language Support",
  "description": "Language support for FreeSpace Open (FSO) mod table files (.tbl / .tbm)",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:fso-table",
    "onCustomEditor:fsoLsp.pofViewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fso-table",
        "aliases": [
          "FSO Table",
          "fso-table"
        ],
        "extensions": [
          ".tbl",
          ".tbm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fso-table",
        "scopeName": "source.fso-table",
        "path": "./syntaxes/fso-table.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fsoLsp.revealDefinitionOrPofViewer",
        "title": "Go to Definition (FSO Table)"
      },
      {
        "command": "fsoLsp.openPofViewerAtPosition",
        "title": "Open 3D POF Viewer at Position (FSO Table)"
      }
    ],
    "keybindings": [
      {
        "command": "fsoLsp.revealDefinitionOrPofViewer",
        "key": "F12",
        "when": "editorTextFocus && editorLangId == fso-table"
      }
    ],
    "customEditors": [
      {
        "viewType": "fsoLsp.pofViewer",
        "displayName": "FSO POF 3D Viewer",
        "selector": [
          {
            "filenamePattern": "*.pof"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . --noEmit",
    "pretest": "node ../build.js && tsc -p ./tsconfig.test.json",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "three": "^0.169.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^18.19.0",
    "@types/three": "^0.169.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "mocha": "^10.7.3",
    "typescript": "^5.5.4"
  }
}
