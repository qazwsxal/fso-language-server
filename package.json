{
  "name": "fso-lsp-workspace",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit",
    "test": "npm run test --workspace=server && npm run test --workspace=client"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
